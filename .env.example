# ============================================================
# 开放管理后台 — 环境变量配置模板
# Copyright (c) 2026 erik <erik@erik.xyz> — https://erik.xyz
#
# 使用方法: 复制此文件为 .env 并修改配置值
#   cp .env.example .env
#
# 注意: .env 文件包含敏感信息，已加入 .gitignore，切勿提交到版本库
# 注意: 所有 CHANGE_ME_ 开头的占位值（密钥/口令）部署前必须替换为强随机值，
#       应用启动时会强校验并拒绝占位值启动（fail-fast），切勿直接用于生产。
#       自动替换: bash scripts/gen-env-keys.sh .env（openssl rand -hex 32 强随机值）
# ============================================================

# ── 应用配置 ──
# 应用名称
APP_NAME=开放管理后台
# 运行环境: production=生产（DB 等口令强制非空校验，请参照 .env.docker） development=开发
APP_ENV=development
# 调试模式: true=开启 false=关闭（生产环境务必关闭）
APP_DEBUG=false
# 应用URL
APP_URL=http://localhost:8788
APP_KEY=bc77805a0b0acbd0d439f60b627cf9e7

# ── 注册开关 ──
# 是否开放用户自助注册（POST /api/auth/register）: 1=开启 0=关闭（默认关闭，生产环境建议保持关闭）
REGISTRATION_ENABLED=0

# ── JWT 认证（erikwang2013/jwt-webman） ──
# 签名密钥，生产环境请使用 64 位以上随机字符串；部署前必须替换（openssl rand -hex 32）
JWT_SECRET_KEY=636ffaf552feb7dbf30701df2ed5a2cff36a05656f700839
# 签名算法: HS256 / HS384 / HS512 / RS256
JWT_ALGORITHM=HS256
# 访问令牌有效期（秒），默认 7200（2小时）
JWT_DEFAULT_EXPIRE=7200
# 刷新令牌有效期（秒），默认 1209600（14天）
JWT_REFRESH_EXPIRE=1209600
# 签发者标识
JWT_ISSUER=open-admin
# 受众标识
JWT_AUDIENCE=open-admin

# ── Hashids ID 加解密（erikwang2013/hashids） ──
# 主连接盐值，部署前必须替换为随机字符串
HASHIDS_SALT=e85b634d2a422a99e6a921d4e9aa9d63e48965ee2ff7f409
# 备用连接盐值
HASHIDS_ALT_SALT=2iYaHtDsAELzuVWfN3FXx4mbkqldj5IpnPveR97KBhyCSgGZUOo1J0T68MwcQrNJ

# ── Snowflake ID 生成（erikwang2013/snowflake-php） ──
# 数据中心 ID，取值范围 0-31，单机房保持默认
SNOWFLAKE_DATACENTER_ID=1
# 工作节点 ID，取值范围 0-31，同机房每台机器需不同
SNOWFLAKE_WORKER_ID=1
# 起始时间戳（毫秒），修改会导致已生成 ID 失效
SNOWFLAKE_START_TIMESTAMP=1700000000000

# ── API 传输层加密（erikwang2013/encryption） ──
# AES 加密密钥，部署前必须替换为 32 字节随机字符串
ENCRYPTION_KEY=99c5c96436b3a397010e73b88163d000
# 加密算法: AES-256-CBC / sm4-ecb / sm4-cbc
ENCRYPTION_CIPHER=AES-256-CBC
# 初始化向量（IV），CBC 模式需要 16 字节，留空使用内置默认
ENCRYPTION_IV=3QMvmg9Zn2apiDwt

# ── 数据库存储层加密（erikwang2013/encryptable） ──
# 数据库敏感字段加密密钥，与传输密钥独立
# 注意: encryptable 插件也使用 ENCRYPTION_KEY 和 ENCRYPTION_CIPHER 这两个变量名
# 此处为数据库层单独配置，如需与传输层共用则保持相同值；部署前必须替换
ENCRYPTABLE_KEY=0d96e787a0f85a3a4b11952add2bf6ae
# 数据库加密算法: aes-128-ecb / aes-256-cbc
ENCRYPTABLE_CIPHER=AES-256-CBC
# 历史密钥列表（用于密钥轮换），逗号分隔
ENCRYPTION_PREVIOUS_KEYS=

# ── Elasticsearch（erikwang2013/webman-scout） ──
# ES 驱动: elasticsearch / opensearch / meilisearch
SCOUT_DRIVER=opensearch
# ES 主机地址，多节点逗号分隔（opensearch 驱动用下方 OPENSEARCH_HOST）
SCOUT_HOSTS=http://localhost:9200
# SCOUT_OPENSEARCH_USERNAME=admin
# SCOUT_OPENSEARCH_PASSWORD=Ab1@b1d2fdde026e
# 索引名称前缀，与数据库表前缀一致
SCOUT_PREFIX=opensearch_
# 索引分片数
SCOUT_SHARDS=1
# 索引副本数
SCOUT_REPLICAS=0
# 批量同步块大小
SCOUT_CHUNK_SIZE=500
# 软删除数据自动从索引移除
SCOUT_SOFT_DELETE=true

# ── 点击验证码（erikwang2013/poster-php） ──
# 图片处理驱动: auto / gd / imagick
POSTER_IMAGE_DRIVER=auto
# JPEG 输出质量 0-100
POSTER_IMAGE_QUALITY=90
# 验证码存储: auto / file / session / redis
POSTER_CAPTCHA_STORAGE=file
# 验证码有效期（秒）
POSTER_CAPTCHA_TTL=300
# 同一 key 最大验证次数
POSTER_CAPTCHA_MAX_ATTEMPTS=3
# 默认难度: easy(2点) / medium(3点) / hard(4点)
POSTER_CAPTCHA_DIFFICULTY=medium

# ── 数据库连接 ──
# 数据库类型: mysql / pgsql / sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=root
DB_PREFIX=erp_
# 数据库口令；生产环境（APP_ENV=production）禁止为空，部署前必须替换为强随机口令
DB_PASSWORD=nBLgTykYR84haUu2EAGo

# ── Redis 连接 ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ── 队列连接 ──
# 队列驱动: redis / rabbitmq
QUEUE_DRIVER=redis
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
# RabbitMQ 口令，部署前必须替换为强随机口令（使用 rabbitmq 驱动时强制非空）
RABBITMQ_PASSWORD=RULZQP5bKOe0VDlcpsqSE4J7hBHtawru3vYfMdImgoAz1jGT82nxNWC96kXiyF8b
RABBITMQ_VHOST=/

# ── Session ──
# 驱动类型: file / redis（生产环境建议 redis）
SESSION_TYPE=redis
# Cookie 仅通过 HTTPS 传输（生产环境务必设为 true）
SESSION_SECURE=false
# SameSite 策略: Lax / Strict / None
SESSION_SAME_SITE=Lax


# ── opensearch 安全认证 ──
OPENSEARCH_HTTP_HOST=https://127.0.0.1:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Ab1@b1d2fdde026e
#是否开启ssl
#OPENSEARCH_SSL_VERIFICATION=false
#ssl证书
#OPENSEARCH_SSL_CERT=
#ssl key
#OPENSEARCH_SSL_KEY=

# ── Elasticsearch 安全认证 ──
# ES 用户名，需与 docker-compose 中 ES_USERNAME 一致
ES_USERNAME=elastic
# ES 密码，部署前必须替换为强随机口令（需与 docker-compose 中 ES 容器口令一致）
ES_PASSWORD=QGmxi2lB1S4nC9FrjaXY8Lyzg3Dhok0HWOVNuTbqe5w6JtURpcIdZs7KfAPvMEok

# ── CORS 跨域白名单 ──
# 逗号分隔的允许来源列表，未命中则不返回 CORS 头
CORS_ALLOWED_ORIGIN=http://localhost
APP_HTTP_PORT=8788
APP_WS_PORT=8282
