        iv3 [label="批次追踪\n批次/批号", fillcolor="#ffecb3", color="#ffa000"];
        iv4 [label="序列号追踪\n单品序列号", fillcolor="#ffecb3", color="#ffa000"];
        iv5 [label="仓库调拨\n多仓库转移", fillcolor="#ffecb3", color="#ffa000"];
