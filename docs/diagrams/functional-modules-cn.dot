digraph FunctionalModulesCN {
    rankdir=TB;
    fontname="Arial";
    fontsize=14;
    bgcolor="transparent";
    nodesep=0.4;
    ranksep=0.6;
    compound=true;
    splines=polyline;

    root [label="开放ERP系统\n功能模块总览\n19 个业务领域 / 163 张表\n121 个控制器",
          shape="box", style="filled,rounded", fillcolor="#1a237e", color="#0d47a1",
          fontcolor="white", fontsize=14, fontname="Arial Bold", penwidth=2];

    node [fontname="Arial", fontsize=9, style="filled,rounded", penwidth=1.5];

    subgraph cluster_auth { label="认证与安全"; fontsize=12; fontname="Arial Bold";
        style="filled,rounded"; fillcolor="#e3f2fd"; color="#1565c0"; penwidth=2;
        a1 [label="登录/注册\n点击验证码", fillcolor="#bbdefb", color="#1976d2"];
        a2 [label="JWT 令牌\n访问+刷新", fillcolor="#bbdefb", color="#1976d2"];
        a3 [label="账号锁定\n5次失败锁定15分钟", fillcolor="#bbdefb", color="#1976d2"];
        a4 [label="会话限制\n每用户最多3令牌", fillcolor="#bbdefb", color="#1976d2"];
        a5 [label="安全登出\nRedis 黑名单", fillcolor="#bbdefb", color="#1976d2"];
    }

    subgraph cluster_dash { label="仪表盘"; fontsize=12; fontname="Arial Bold";
        style="filled,rounded"; fillcolor="#e8f5e9"; color="#2e7d32"; penwidth=2;
        d1 [label="经营总览\n统计卡片", fillcolor="#c8e6c9", color="#388e3c"];
        d2 [label="销售看板\n趋势折线图", fillcolor="#c8e6c9", color="#388e3c"];
        d3 [label="库存看板\n库存水位", fillcolor="#c8e6c9", color="#388e3c"];
        d4 [label="财务看板\n关键指标", fillcolor="#c8e6c9", color="#388e3c"];
    }

    subgraph cluster_admin { label="系统管理"; fontsize=12; fontname="Arial Bold";
        style="filled,rounded"; fillcolor="#fff3e0"; color="#e65100"; penwidth=2;
        ad1 [label="用户管理\n增删改查+批量+导入", fillcolor="#ffe0b2", color="#ef6c00"];
        ad2 [label="角色与权限\nRBAC 权限树", fillcolor="#ffe0b2", color="#ef6c00"];
        ad3 [label="系统配置\n键值对分组", fillcolor="#ffe0b2", color="#ef6c00"];
        ad4 [label="操作审计\n日志查询+来源端检测", fillcolor="#ffe0b2", color="#ef6c00"];
        ad5 [label="文件管理\n上传+导出", fillcolor="#ffe0b2", color="#ef6c00"];
    }

    subgraph cluster_sec { label="安全防护层"; fontsize=12; fontname="Arial Bold";
        style="filled,rounded"; fillcolor="#ffebee"; color="#b71c1c"; penwidth=2;
        se1 [label="XSS 防护\n输入净化", fillcolor="#ffcdd2", color="#d32f2f"];
        se2 [label="SQL 注入防御\n参数化查询", fillcolor="#ffcdd2", color="#d32f2f"];
        se3 [label="路径遍历阻止\n路径验证", fillcolor="#ffcdd2", color="#d32f2f"];
        se4 [label="命令注入防御\nShell 转义", fillcolor="#ffcdd2", color="#d32f2f"];
        se5 [label="CSRF 防护\n令牌验证", fillcolor="#ffcdd2", color="#d32f2f"];
        se6 [label="限流控制\nRedis 滑动窗口", fillcolor="#ffcdd2", color="#d32f2f"];
        se7 [label="CSP 响应头\n内容安全策略", fillcolor="#ffcdd2", color="#d32f2f"];
        se8 [label="数据加密\n传输+存储双重加密", fillcolor="#ffcdd2", color="#d32f2f"];
    }

    subgraph cluster_ops { label="运维监控"; fontsize=12; fontname="Arial Bold";
        style="filled,rounded"; fillcolor="#e0f2f1"; color="#00695c"; penwidth=2;
        op1 [label="健康检查\n数据库/Redis/ES", fillcolor="#b2dfdb", color="#00897b"];
        op2 [label="Prometheus\n5 项监控指标", fillcolor="#b2dfdb", color="#00897b"];
        op3 [label="API 文档\nOpenAPI 3.0", fillcolor="#b2dfdb", color="#00897b"];
        op4 [label="security.txt\nRFC 9116", fillcolor="#b2dfdb", color="#00897b"];
        op5 [label="数据库备份\nmysqldump+gzip", fillcolor="#b2dfdb", color="#00897b"];
        op6 [label="CI/CD\nGitHub Actions", fillcolor="#b2dfdb", color="#00897b"];
    }

    subgraph cluster_product { label="商品管理"; fontsize=12; fontname="Arial Bold";
        style="filled,rounded"; fillcolor="#ede7f6"; color="#4527a0"; penwidth=2;
        pd1 [label="商品档案\n名称/编码/规格", fillcolor="#d1c4e9", color="#5e35b1"];
        pd2 [label="SKU 与规格\n多规格支持", fillcolor="#d1c4e9", color="#5e35b1"];
        pd3 [label="多单位\n单位换算", fillcolor="#d1c4e9", color="#5e35b1"];
        pd4 [label="分类树\n多级分类", fillcolor="#d1c4e9", color="#5e35b1"];
        pd5 [label="品牌\n品牌管理", fillcolor="#d1c4e9", color="#5e35b1"];
        pd6 [label="仓库\n多仓库管理", fillcolor="#d1c4e9", color="#5e35b1"];
        pd7 [label="供应商\n联系人+银行账户", fillcolor="#d1c4e9", color="#5e35b1"];
        pd8 [label="客户\n信用额度", fillcolor="#d1c4e9", color="#5e35b1"];
    }

    subgraph cluster_purch { label="采购管理"; fontsize=12; fontname="Arial Bold";
