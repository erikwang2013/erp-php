# ============================================================
# Docker 环境变量
# Copyright (c) 2026 erik <erik@erik.xyz> — https://erik.xyz
#
# 使用方法: cp .env.docker .env && docker-compose up -d
# 注意: 生产部署前务必替换所有 change-me 占位符
# ============================================================

# ── 应用配置 ──
APP_NAME=开放管理后台
APP_DEBUG=false
APP_URL=http://localhost

# ── JWT 认证（生产密钥务必修改） ──
JWT_SECRET_KEY=change-me-in-production-use-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=open-admin
JWT_AUDIENCE=open-admin
JWT_DEFAULT_EXPIRE=7200
JWT_REFRESH_EXPIRE=1209600

# ── Hashids ID 加解密 ──
HASHIDS_SALT=change-me-hashids-salt-production
HASHIDS_ALT_SALT=change-me-alt-salt-production

# ── Snowflake ID 生成 ──
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_START_TIMESTAMP=1700000000000

# ── API 传输层加密 ──
ENCRYPTION_KEY=change-me-32-byte-encryption-key!
ENCRYPTION_CIPHER=AES-256-CBC
ENCRYPTION_IV=

# ── 数据库存储层加密 ──
ENCRYPTABLE_KEY=change-me-32-byte-db-encrypt-key!
ENCRYPTABLE_CIPHER=AES-256-CBC
ENCRYPTION_PREVIOUS_KEYS=

# ── Elasticsearch（erikwang2013/webman-scout） ──
SCOUT_DRIVER=elasticsearch
SCOUT_HOSTS=http://elasticsearch:9200
SCOUT_PREFIX=erik_
SCOUT_SHARDS=1
SCOUT_REPLICAS=0
SCOUT_CHUNK_SIZE=500
SCOUT_SOFT_DELETE=true
# ES 安全认证，需与 docker-compose 中 ES_PASSWORD 一致
ES_USERNAME=elastic
ES_PASSWORD=changeme

# ── 点击验证码 ──
POSTER_IMAGE_DRIVER=auto
POSTER_IMAGE_QUALITY=90
POSTER_CAPTCHA_STORAGE=redis
POSTER_CAPTCHA_TTL=300
POSTER_CAPTCHA_MAX_ATTEMPTS=3
POSTER_CAPTCHA_DIFFICULTY=medium

# ── 数据库连接 ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=open_admin
DB_USERNAME=root
DB_PASSWORD=root

# ── Redis 连接 ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ── 队列连接 ──
# 队列驱动: redis / rabbitmq（docker-compose 未内置 rabbitmq 服务，使用 redis 即可）
QUEUE_DRIVER=redis
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── Session 安全 ──
SESSION_TYPE=redis
SESSION_SECURE=true
SESSION_SAME_SITE=Lax

# ── CORS 跨域白名单 ──
CORS_ALLOWED_ORIGIN=http://localhost
